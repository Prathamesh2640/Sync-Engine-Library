<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.

   The SyncEngine-backed Room database (notes.db, plus its -wal/-shm/-journal
   side files) is excluded from both cloud backup and device-to-device transfer
   via the whole "database" domain: it can hold tombstoned (soft-deleted) rows
   that have not yet passed tombstoneRetentionDays. Restoring an old backup
   would resurrect data the user already deleted, undermining the library's
   SEC-10 / GDPR "right to erasure" purge (see RoomSyncAdapter.purgeExpiredTombstones).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>