<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for API < 31 (ignored on API 31+, see data_extraction_rules.xml).
   See https://developer.android.com/guide/topics/data/autobackup
   for details.

   The SyncEngine-backed Room database (notes.db, plus its -wal/-shm/-journal
   side files) is excluded via the whole "database" domain: it can hold
   tombstoned (soft-deleted) rows that have not yet passed
   tombstoneRetentionDays. Including it in a device backup would let a restore
   resurrect data the user already deleted, undermining the library's SEC-10 /
   GDPR "right to erasure" purge (see RoomSyncAdapter.purgeExpiredTombstones).
-->
<full-backup-content>
    <exclude domain="database" path="." />
</full-backup-content>